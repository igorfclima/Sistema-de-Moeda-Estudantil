@startuml Creditar Moedas Semestrais

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontColor #000000

skinparam participant {
    BackgroundColor #FFFFFF
    BorderColor #000000
    FontColor #000000
}
skinparam actor {
    BackgroundColor #FFFFFF
    BorderColor #000000
    FontColor #000000
}
skinparam database {
    BackgroundColor #FFFFFF
    BorderColor #000000
    FontColor #000000
}
skinparam sequence {
    ArrowColor #000000
    LifeLineBorderColor #000000
    LifeLineBackgroundColor #FFFFFF
    GroupBackgroundColor #FFFFFF
    GroupBorderColor #000000
    DividerBackgroundColor #FFFFFF
    DividerBorderColor #000000
}

actor       "Professor"         as Prof
participant "Sistema de Mérito" as Sistema
participant "Agendador"         as Scheduler
database    "Banco de Dados"    as DB
participant "Notificador"       as Notif

== 1. Disparo Automático Semestral ==

Scheduler -> Sistema : 1.1 executarCreditoSemestral()
activate Sistema

Sistema -> DB : 1.2 buscarTodosProfessores()
activate DB
DB --> Sistema : 1.3 listaProfessores
deactivate DB

loop Para cada professor ativo
    Sistema -> DB : 1.4 buscarSaldoAtual(professorId)
    activate DB
    DB --> Sistema : 1.5 saldoAtual
    deactivate DB

    Sistema -> Sistema : 1.6 calcularNovoSaldo(saldoAtual, cotaSemestral)

    Sistema -> DB : 1.7 atualizarSaldo(professorId, novoSaldo)
    activate DB
    DB --> Sistema : 1.8 saldoAtualizado
    deactivate DB

    Sistema -> DB : 1.9 registrarCredito(professorId, cotaSemestral, "Crédito Semestral")
    activate DB
    DB --> Sistema : 1.10 creditoRegistrado
    deactivate DB

    Sistema -> Notif : 1.11 notificarCredito(professor, cotaSemestral)
    activate Notif
    Notif --> Prof : 1.12 email(moedas creditadas no semestre)
    deactivate Notif
end

Sistema --> Scheduler : 1.13 relatorioCredito(totalProfessores, totalMoedasCreditadas)
deactivate Sistema

@enduml
