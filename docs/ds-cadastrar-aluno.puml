@startuml Cadastrar Aluno

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontColor #000000

skinparam participant {
    BackgroundColor #FFFFFF
    BorderColor #000000
    FontColor #000000
}
skinparam actor {
    BackgroundColor #FFFFFF
    BorderColor #000000
    FontColor #000000
}
skinparam database {
    BackgroundColor #FFFFFF
    BorderColor #000000
    FontColor #000000
}
skinparam sequence {
    ArrowColor #000000
    LifeLineBorderColor #000000
    LifeLineBackgroundColor #FFFFFF
    GroupBackgroundColor #FFFFFF
    GroupBorderColor #000000
    DividerBackgroundColor #FFFFFF
    DividerBorderColor #000000
}

actor       "Administrador"     as Admin
actor       "Aluno"             as Aluno
participant "Sistema de Mérito" as Sistema
database    "Banco de Dados"    as DB
participant "Notificador"       as Notif

== 1. Cadastro de Aluno ==

Admin -> Sistema : 1.1 cadastrarAluno(nome, email, cpf, senha, instituicaoId)
activate Sistema

Sistema -> DB : 1.2 verificarEmail(email)
activate DB
DB --> Sistema : 1.3 resultado
deactivate DB

alt Email não cadastrado
    Sistema -> DB : 1.4 buscarInstituicao(instituicaoId)
    activate DB
    DB --> Sistema : 1.5 instituicao
    deactivate DB

    Sistema -> DB : 1.6 salvarAluno(nome, email, cpf, senhaHash, instituicao)
    activate DB
    DB --> Sistema : 1.7 alunoSalvo
    deactivate DB

    Sistema -> Notif : 1.8 enviarBoasVindas(aluno, credenciais)
    activate Notif
    Notif --> Aluno : 1.9 email(login e senha de acesso)
    deactivate Notif

    Sistema --> Admin : 1.10 alunoRegistrado(id, nome)

else Email já cadastrado
    Sistema --> Admin : 1.11 erro("E-mail já está em uso")
end

deactivate Sistema

@enduml
